# PostgreSQL Database URL (Local, Neon, or Supabase)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aldan

# Better-Auth Secret (generate with `openssl rand -base64 32`)
BETTER_AUTH_SECRET=change-this-to-a-secure-random-secret-key-in-production
BETTER_AUTH_URL=http://localhost:3000

# Google Gemini API Key for Vercel AI SDK
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
